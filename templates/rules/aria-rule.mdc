### shadcn/ui Dialog Component with ARIA

```typescript
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog"

// Confirmation dialog
<Dialog open={isOpen} onOpenChange={setIsOpen}>
  <DialogTrigger asChild>
    <Button aria-label="Delete this item">Delete</Button>
  </DialogTrigger>
  <DialogContent 
    aria-labelledby="dialog-title"
    aria-describedby="dialog-description"
  >
    <DialogHeader>
      <DialogTitle id="dialog-title">Confirm Deletion</DialogTitle>
      <DialogDescription id="dialog-description">
        This action cannot be undone. Are you sure?
      </DialogDescription>
    </DialogHeader>
    <div className="flex gap-2">
      <Button 
        variant="destructive"
        aria-label="Confirm and delete item"
        onClick={handleDelete}
      >
        Delete
      </Button>
      <Button 
        variant="outline"
        aria-label="Cancel deletion"
        onClick={() => setIsOpen(false)}
      >
        Cancel
      </Button>
    </div>
  </DialogContent>
</Dialog>
```

### shadcn/ui Form Component with ARIA

```typescript
import { Form, FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage } from "@/components/ui/form"
import { useForm } from "react-hook-form"

// Form with validation
const { control, formState: { errors } } = useForm()

<Form {...form}>
  <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
    <FormField
      control={control}
      name="username"
      render={({ field }) => (
        <FormItem>
          <FormLabel htmlFor="username">Username *</FormLabel>
          <FormControl>
            <Input 
              {...field}
              id="username"
              type="text"
              placeholder="Enter your username"
              aria-label="Username"
              aria-required="true"
              aria-invalid={!!errors.username}
              aria-describedby={errors.username ? "username-error" : undefined}
            />
          </FormControl>
          <FormDescription>
            3-20 characters, letters and numbers only
          </FormDescription>
          {errors.username && (
            <FormMessage id="username-error" role="alert">
              {errors.username.message}
            </FormMessage>
          )}
        </FormItem>
      )}
    />
  </form>
</Form>
```

### shadcn/ui Tabs Component with ARIA

```typescript
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"

// Tab navigation
<Tabs 
  defaultValue="overview"
  aria-label="Content tabs"
>
  <TabsList role="tablist">
    <TabsTrigger 
      value="overview"
      aria-label="View overview content"
      aria-selected={activeTab === "overview"}
      role="tab"
    >
      Overview
    </TabsTrigger>
    <TabsTrigger 
      value="details"
      aria-label="View product details"
      aria-selected={activeTab === "details"}
      role="tab"
    >
      Details
    </TabsTrigger>
  </TabsList>
  <TabsContent value="overview" role="tabpanel">
    {/* Overview content */}
  </TabsContent>
  <TabsContent value="details" role="tabpanel">
    {/* Details content */}
  </TabsContent>
</Tabs>
```

### shadcn/ui Alert Component with ARIA

```typescript
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert"
import { AlertCircle, CheckCircle2, Info } from "lucide-react"

// Error alert
<Alert 
  variant="destructive"
  role="alert"
  aria-live="assertive"
  aria-atomic="true"
>
  <AlertCircle className="h-4 w-4" />
  <AlertTitle>Error</AlertTitle>
  <AlertDescription>
    An error occurred while processing your request
  </AlertDescription>
</Alert>

// Success alert
<Alert 
  variant="default"
  role="status"
  aria-live="polite"
  aria-atomic="true"
>
  <CheckCircle2 className="h-4 w-4" />
  <AlertTitle>Success</AlertTitle>
  <AlertDescription>
    Your changes have been saved successfully
  </AlertDescription>
</Alert>

// Information alert
<Alert 
  role="status"
  aria-live="polite"
>
  <Info className="h-4 w-4" />
  <AlertTitle>Information</AlertTitle>
  <AlertDescription>
    Please note that this action is reversible
  </AlertDescription>
</Alert>
```

